{
  "title": "MIMIR Call Runtime Evidence",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Inbound → Active p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orchestrator_inbound_to_active_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "First Audio p95 by Runtime",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(media_bridge_first_audio_latency_seconds_bucket[5m])) by (runtime, le))",
          "legendFormat": "{{runtime}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RTP Packet Loss p95 by Runtime",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(media_bridge_rtp_packet_loss_pct_bucket[5m])) by (runtime, le))",
          "legendFormat": "{{runtime}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RTP Jitter p95 by Runtime",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(media_bridge_rtp_jitter_ms_bucket[5m])) by (runtime, le))",
          "legendFormat": "{{runtime}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WebSocket Reconnect/Error Rates",
      "targets": [
        {
          "expr": "sum(rate(media_bridge_websocket_reconnect_total[5m])) by (runtime)",
          "legendFormat": "reconnect {{runtime}}"
        },
        {
          "expr": "sum(rate(media_bridge_websocket_error_total[5m])) by (runtime)",
          "legendFormat": "errors {{runtime}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Call Completion and Failure Reasons",
      "targets": [
        {
          "expr": "sum(rate(media_bridge_call_completion_total[5m])) by (result, reason, runtime)",
          "legendFormat": "{{runtime}} {{result}} {{reason}}"
        }
      ]
    }
  ]
}
