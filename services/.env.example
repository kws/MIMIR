# Copy this file to .env and set your API key(s) before running docker compose.
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: change the default scientist model globally for all extension profiles.
SCIENTIST_MODEL_NAME=gpt-realtime-mini

# Optional: media-bridge RTP binding and advertised endpoint for ExternalMedia / RTP verification.
MEDIA_BRIDGE_RTP_BIND_ADDRESS=0.0.0.0
MEDIA_BRIDGE_RTP_ADVERTISED_ADDRESS=media-bridge
MEDIA_BRIDGE_RTP_PORT_START=12000
MEDIA_BRIDGE_RTP_PORT_END=12099
MEDIA_BRIDGE_PLAYOUT_MAX_DEPTH_MS=1200
MEDIA_BRIDGE_PLAYOUT_TARGET_PREFILL_MS=60
MEDIA_BRIDGE_PLAYOUT_STALE_POLICY=drop_oldest
MEDIA_BRIDGE_PLAYOUT_UNDERRUN_POLICY=no_send
MEDIA_BRIDGE_INBOUND_JITTER_BUFFER_PACKETS=3

# Optional: local observability ports and Grafana credentials for the compose test bed.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
